# dependencies
node_modules/
.node_modules.lock

# build output
dist/
.output/
.nitro/
.vercel/
.tanstack/

# local env — the platform injects these on deploy, never commit them
.env
.env.*
!.env.example

# editor / OS
.DS_Store
Thumbs.db
*.log

# local dev-server launcher (machine specific)
.claude/
dist-desktop/
release/

# 含个人资料的旧截图仅保留在本机，不进入公开仓库。
/attachments/
# screenshots 只保留 README 引用的展示图；测试与截图脚本（scripts/*smoke*、
# *integration*）产生的截图与 JSON 都是本地产物。新增展示图用
# `git add -f screenshots/xxx.png` 显式加入。
/screenshots/*
!/screenshots/nanpad-v0*/
!/screenshots/.gitkeep

# i18n 工具运行时落在仓库根目录的中间产物
/scratchpad-*.json

# 本机诊断文件，不用于发布
/screen_check.png
/tray_crop.png
/scripts/test-win.mjs
/public/openai-preview.html

# 自托管网页版
dist-web/
zhiyu-data/
