<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="知屿安装程序" Width="1000" Height="740" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterScreen" Background="White" FontFamily="Microsoft YaHei UI" Foreground="#22334c">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#dde5f0"/><Setter Property="Foreground" Value="#22334c"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3b6fe0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3b6fe0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="46"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#68778f"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="36"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,18,0"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="670"><Grid.ColumnDefinitions><ColumnDefinition Width="38*"/><ColumnDefinition Width="62*"/></Grid.ColumnDefinitions>
      <Border Background="#eef4fe" Padding="32"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Image x:Name="BrandLogo" Width="48" Height="48"/><TextBlock Text="知屿" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/><TextBlock Text="Zhiyu" Style="{StaticResource Hint}" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,40,0,0"><TextBlock Text="给数字生活，一处安放。" Foreground="#254d9b" FontSize="12"/><TextBlock Text="从这里，&#10;连接你的世界。" FontSize="33" FontWeight="SemiBold" LineHeight="48" Margin="0,16,0,14"/><TextBlock Text="文档、账号与数字资产，&#10;在你的工作空间相遇。" Style="{StaticResource Hint}"/></StackPanel>
        <Grid Grid.Row="2" Height="230" Margin="0,22,0,12" VerticalAlignment="Center">
          <Ellipse Width="250" Height="160" Stroke="#ceddf6" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><RotateTransform Angle="-22"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="200" Height="200" Stroke="#dce6fa" StrokeDashArray="3 4"/>
          <Border Width="104" Height="104" Background="White" CornerRadius="28"><Image x:Name="IslandLogo" Width="78" Height="78"/></Border>
          <Border x:Name="DocumentNode" Background="White" CornerRadius="10" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,30,0,0"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><TextBlock Text="文档" Foreground="#3b6fe0"/></Border>
          <Border x:Name="AccountNode" Background="White" CornerRadius="10" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,0,0"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><TextBlock Text="账号" Foreground="#208d98"/></Border>
          <Border x:Name="ServerNode" Background="White" CornerRadius="10" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="38,0,0,10"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><TextBlock Text="主机" Foreground="#3b6fe0"/></Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="资料由你掌握                  开源 · 本地优先" Style="{StaticResource Hint}" FontSize="10"/>
      </Grid></Border>
      <Grid Grid.Column="1" Margin="36,30,36,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="Step1" Text="① 安装偏好" Foreground="#3b6fe0"/><TextBlock x:Name="Step2" Text="② 准备空间" Grid.Column="1" HorizontalAlignment="Center"/><TextBlock x:Name="Step3" Text="③ 开启知屿" Grid.Column="2" HorizontalAlignment="Right"/></Grid>
        <StackPanel x:Name="Setup" Grid.Row="1">
          <TextBlock Text="为知屿选一个位置" Style="{StaticResource Heading}"/><TextBlock Text="几项简单设置，然后就可以开始了。" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
          <TextBlock Text="安装目录" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBox x:Name="Directory" Padding="10" VerticalContentAlignment="Center" BorderBrush="#dde5f0" FontFamily="Consolas"/><Button x:Name="Browse" Content="更改" Grid.Column="1" Margin="8,0,0,0" Padding="10"/></Grid>
          <TextBlock x:Name="DirectoryHint" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,20"/>
          <TextBlock Text="安装范围" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><RadioButton x:Name="CurrentUser" Content="仅当前用户" GroupName="Scope" IsChecked="True"/><RadioButton x:Name="AllUsers" Content="这台电脑的所有用户" GroupName="Scope"/></StackPanel>
          <CheckBox x:Name="Desktop" IsChecked="True" Content="创建桌面快捷方式"/><CheckBox x:Name="Startup" Content="登录 Windows 后启动知屿"/>
          <Border BorderBrush="#dde5f0" BorderThickness="0,1,0,0" Margin="0,16,0,16" Padding="0,12,0,0"><TextBlock x:Name="Permission" Text="仅为当前用户安装；目录不可写时请换一个位置，或选择所有用户安装。" Style="{StaticResource Hint}"/></Border>
          <Button x:Name="Start" Content="开始安装" Style="{StaticResource Primary}"/>
          <TextBlock Text="基于 MIT 开源许可 · 不捆绑其他软件" Style="{StaticResource Hint}" FontSize="10" TextAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel x:Name="Installing" Grid.Row="1" Visibility="Collapsed">
          <TextBlock x:Name="InstallHeading" Text="正在准备你的知屿" Style="{StaticResource Heading}"/><TextBlock x:Name="InstallSubtitle" Text="把需要的东西放好，很快就能见面。" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="Percent" Text="0%" FontSize="56" FontWeight="Light" Foreground="#3b6fe0" LineHeight="80" Margin="0,32,0,8"/><ProgressBar x:Name="Progress" Height="6" Maximum="100" Foreground="#3b6fe0" Background="#eef4fe" BorderThickness="0"/>
          <TextBlock x:Name="Detail" Style="{StaticResource Hint}" Margin="0,12,0,24"/>
          <TextBlock x:Name="DownloadTask" Text="○ 下载程序" Margin="0,12"/><TextBlock x:Name="VerifyTask" Text="○ 校验文件完整性" Margin="0,12"/><TextBlock x:Name="InstallTask" Text="○ 安装并创建入口" Margin="0,12"/>
          <TextBlock x:Name="Error" Foreground="#a33a38" FontSize="12" Margin="0,14"/>
          <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Retry" Content="重新下载" Visibility="Collapsed" Margin="0,0,12,0"/><Button x:Name="Cancel" Content="取消下载" Grid.Column="1"/></Grid>
        </StackPanel>
        <StackPanel x:Name="Done" Grid.Row="1" Visibility="Collapsed">
          <Border Background="#eef4fe" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,12,0,24"><TextBlock Text="✓" Foreground="#208d98" FontSize="30" TextAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="一切就绪，欢迎上屿。" Style="{StaticResource Heading}"/><TextBlock Text="你的数字生活，现在有了一处安放。" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="Summary" Margin="0,28,0,24" LineHeight="32"/>
          <Button x:Name="Launch" Content="开启知屿" Style="{StaticResource Primary}"/><Button x:Name="Finish" Content="完成" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Footer" Grid.Row="2" Text="Windows 在线安装器" Style="{StaticResource Hint}" FontSize="10" Margin="0,22,0,0"/>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
