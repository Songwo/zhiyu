{
  "name": "zhiyu",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "extension:build": "node scripts/build-extension.mjs",
    "dev": "node scripts/with-app-env.mjs node node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs node node_modules/vite/bin/vite.js build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs node node_modules/vite/bin/vite.js build --mode development",
    "preview": "node scripts/with-app-env.mjs node node_modules/vite/bin/vite.js preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test scripts/*.test.mjs electron/services/*.test.mjs && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/parse-paste.test.ts src/lib/agent.test.ts src/lib/i18n.test.ts src/lib/operations.test.ts src/lib/asset-view.test.ts src/lib/ai-subscriptions.test.ts src/lib/mail-folders.test.ts src/lib/secret-folders.test.ts src/lib/quick-start.test.ts src/lib/subscription-templates.test.ts src/lib/renewal-step.test.ts",
    "i18n:check": "node --experimental-strip-types scripts/i18n-check.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:build": "node node_modules/vite/bin/vite.js build --config vite.desktop.config.ts",
    "desktop:pack": "npm run desktop:build && node scripts/package-desktop.mjs --dir --publish never",
    "desktop:dist": "npm run desktop:build && node scripts/package-desktop.mjs --publish never",
    "desktop:portable": "node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "electron-updater": "^6.8.9",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.7.8",
    "jose": "6.2.9",
    "js-yaml": "^4.3.2",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "mailparser": "^3.9.23",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.0.1",
    "openai": "^7.10.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  },
  "productName": "知屿 Zhiyu",
  "version": "1.11.0",
  "author": "Songwo",
  "homepage": "https://github.com/Songwo/zhiyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Songwo/zhiyu.git"
  },
  "description": "知屿 Zhiyu — 连接文档、账号与数字资产的个人工作空间",
  "build": {
    "protocols": [
      {
        "name": "Zhiyu website capture",
        "schemes": [
          "nanpad"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "zhiyu.ico"
      }
    ],
    "appId": "dev.songwo.nanpad",
    "productName": "Zhiyu",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-desktop/**/*",
      "package.json",
      "!electron/renderer/index.html",
      "!electron/**/*.test.mjs"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zhiyu-${version}-setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "知屿 Zhiyu",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Songwo",
        "repo": "zhiyu",
        "releaseType": "release"
      }
    ]
  }
}
